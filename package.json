{
  "name": "market-fiyati-mcp",
  "version": "2.0.0",
  "license": "MIT",
  "author": "Gökhan Çavuş",
  "description": "Unofficial stdio MCP server for Market Fiyatı product search, depot prices and basket comparison in Türkiye",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "market-fiyati-mcp": "dist/src/index.js"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "release:check": "node scripts/check-release.mjs",
    "start": "node dist/src/index.js",
    "test": "npm run build && node --import ./tests/no-network.mjs --test tests/*.test.mjs dist/tests/*.test.js",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "prepack": "npm run build",
    "test:installed": "node scripts/check-installed-package.mjs",
    "test:consumer": "node scripts/test-consumer.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.4",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "js-yaml": "5.4.2",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1"
  },
  "files": [
    "dist/src/**/*.js",
    "docs/api.md",
    "docs/architecture.md",
    "docs/live-testing.md",
    "docs/verification.md",
    "examples/mcp-config.json",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gokhancvs/market-fiyati-mcp.git"
  },
  "homepage": "https://github.com/gokhancvs/market-fiyati-mcp#readme",
  "bugs": {
    "url": "https://github.com/gokhancvs/market-fiyati-mcp/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "market-fiyati",
    "price-comparison",
    "grocery-prices",
    "turkiye",
    "stdio"
  ],
  "mcpName": "io.github.gokhancvs/market-fiyati-mcp"
}
