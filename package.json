{
  "name": "market-fiyati-mcp",
  "version": "1.0.7",
  "license": "MIT",
  "author": "Gökhan Çavuş",
  "description": "Unofficial stdio MCP server for Market Fiyatı product search, depot prices and basket comparison in Türkiye",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "market-fiyati-mcp": "dist/src/index.js"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "format": "prettier . --write && npm run lint -- --fix --fix-type layout",
    "format:check": "prettier . --check",
    "lint": "eslint --ext .ts,.mjs src tests scripts --quiet",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "release:check": "node scripts/check-release.mjs",
    "start": "node dist/src/index.js",
    "test": "npm run build && node --import ./tests/no-network.mjs --test tests/*.test.mjs dist/tests/*.test.js",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "prepack": "npm run build",
    "test:installed": "node scripts/check-installed-package.mjs",
    "test:consumer": "node scripts/test-consumer.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@typescript-eslint/eslint-plugin": "8.70.1",
    "@typescript-eslint/parser": "8.70.1",
    "eslint": "8.57.1",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "js-yaml": "4.3.2",
    "prettier": "3.9.5",
    "typescript": "5.9.3"
  },
  "files": [
    "dist/src/**/*.js",
    "docs/api.md",
    "docs/architecture.md",
    "docs/live-testing.md",
    "docs/offline-acceptance.md",
    "docs/releasing.md",
    "docs/verification.md",
    "docs/releases/v1.0.0.md",
    "docs/releases/v1.0.1.md",
    "docs/releases/v1.0.2.md",
    "docs/releases/v1.0.4.md",
    "docs/releases/v1.0.5.md",
    "docs/releases/v1.0.6.md",
    "docs/releases/v1.0.7.md",
    "examples/mcp-config.json",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gokhancvs/market-fiyati-mcp.git"
  },
  "homepage": "https://github.com/gokhancvs/market-fiyati-mcp#readme",
  "bugs": {
    "url": "https://github.com/gokhancvs/market-fiyati-mcp/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "market-fiyati",
    "price-comparison",
    "grocery-prices",
    "turkiye",
    "stdio"
  ],
  "mcpName": "io.github.gokhancvs/market-fiyati-mcp"
}
